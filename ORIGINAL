        html {
            scroll-behavior: smooth;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Poppins', sans-serif;
        }

        .container {
            display: grid;
            grid-template-rows: auto 1fr 3fr;
            width: 100vw;
            height: 100vh;
            padding: 20px;
        }

        .dropdown-container {
            display: flex;
            flex-direction: row; 
            align-items: center; 
            justify-content: center; 
            margin-bottom: 20px; 
            margin-top: 60px;
        }

        .dropdown-container label {
            margin-right: 10px; 
            font-weight: bold;
        }

        select {
            padding: 10px;
            margin-right: 20px; 
            border: 1px solid #ccc; 
            border-radius: 5px; 
            font-size: 16px; 
            outline: none; 
            transition: border-color 0.3s; 
        }

        select:focus {
            border-color: #007bff; 
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 24px;
            padding: 20px;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .time-gdp, .city-name {
            font-weight: bold;
        }

        .city-name {
            text-align: center;
            flex-grow: 1;
        }

        .right-side {
            display: flex;
            flex-direction: column;
            gap: 10px;
            text-align: right;
        }

        .temperature, .weather {
            font-size: 18px;
            font-weight: bold;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-gap: 20px;
            padding: 20px;
        }

        .box {
            background-color: #e0e0e0;
            text-align: center;
            border-radius: 8px;
            font-size: 18px;
            padding: 40px;
            font-weight: bold;
            color: #333;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .box {
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .box img {
            width: 50px; 
            margin-bottom: 10px; 
        }
        .box:hover {
            transform: translateY(-10px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }
        #grid {
            grid-column: span 1; 
            width: 100%; 
            height: 100%; 
        }
        .data-display {
            font-size: 16px; 
            color: #333;
        }

        .no-data {
            color: red;
        }

        a {
            text-decoration: none;
            display: block; 
        }
        .banner {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: #e0e0e0;
            color: #333;
            text-align: center;
            padding: 10px 0; 
            z-index: 1000; 
        }

        .banner h1 {
            margin: 0; 
            font-size: 24px;
        }

        #map {
            height: 60vh;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            width: 100%;
        }